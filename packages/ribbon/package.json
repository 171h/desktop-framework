{
  "name": "@df/ribbon",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "AutoDesk 风格 Ribbon 插件：从命令元数据自动聚合页签、功能组和按钮，实时求值启用与勾选状态，并提供 nusys-ui 功能区组件",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./RibbonBar.vue": "./src/RibbonBar.vue",
    "./RibbonTabs.vue": "./src/RibbonTabs.vue"
  },
  "dependencies": {
    "@df/commands": "workspace:*",
    "@df/core": "workspace:*",
    "@df/keybindings": "workspace:*",
    "@df/settings": "workspace:*",
    "@df/ui": "workspace:*",
    "@df/vue": "workspace:*",
    "@df/workbench": "workspace:*",
    "cordis": "^4.0.0-rc.12",
    "nusys-ui": "^4.2.1",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@df/kernel": "workspace:*"
  }
}
