    "@df/keybindings": "workspace:*",
    "@df/menu": "workspace:*",
    "@df/notifications": "workspace:*",
    "@df/output": "workspace:*",
    "@df/platform": "workspace:*",
    "@df/properties": "workspace:*",
    "@df/ribbon": "workspace:*",
    "@df/selection": "workspace:*",
    "@df/settings": "workspace:*",
    "@df/statusbar": "workspace:*",
    "@df/surface": "workspace:*",
    "@df/ui": "workspace:*",
    "@df/vscode": "workspace:*",
    "@df/vue": "workspace:*",
    "@df/wasm": "workspace:*",
    "@df/workbench": "workspace:*",
    "@vscode/codicons": "^0.0.46-24",
