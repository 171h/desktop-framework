{
  "name": "desktop-framework",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "description": "面向复杂桌面软件的插件化跨平台应用框架：Rust + WebAssembly + Vue 3 + Electron",
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @desktop-framework/playground-web dev",
    "dev:desktop": "pnpm build:wasm && pnpm --filter @desktop-framework/playground-desktop dev",
    "build": "pnpm build:wasm && pnpm build:web && pnpm build:desktop",
    "build:web": "pnpm --filter @desktop-framework/playground-web build",
    "build:desktop": "pnpm --filter @desktop-framework/playground-desktop build",
    "build:wasm": "node scripts/build-wasm.mjs",
    "build:wasm:dev": "node scripts/build-wasm.mjs --dev",
    "package:desktop": "pnpm build:wasm && pnpm --filter @desktop-framework/playground-desktop dist",
    "preview": "pnpm --filter @desktop-framework/playground-web preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "eslint .",
    "docs:dev": "pnpm --filter @desktop-framework/docs dev",
    "docs:build": "pnpm --filter @desktop-framework/docs build",
    "docs:preview": "pnpm --filter @desktop-framework/docs preview",
    "rust:fmt": "cargo fmt --all",
    "rust:fmt:check": "cargo fmt --all --check",
    "rust:clippy": "cargo clippy --workspace --all-targets -- -D warnings",
    "rust:test": "cargo test --workspace",
    "rust:check:wasm": "cargo check -p df_ast -p df_geometry -p df_importer -p df_plugin_obj -p df_plugin_stl -p df_plugin_gltf -p df_wasm --target wasm32-unknown-unknown",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm rust:fmt:check && pnpm rust:clippy",
    "prepare": "node scripts/ensure-submodules.mjs"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@iconify-json/lucide": "^1.2.147",
    "@types/node": "^26.6.5",
    "@unocss/eslint-plugin": "^66.12.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vscode/codicons": "^0.0.46-24",
    "@vue/test-utils": "^2.5.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.13.0",
    "happy-dom": "^21.0.4",
    "nusys-ui": "^4.2.1",
    "pinia": "^4.1.0",
    "typescript": "^7.0.2",
    "unocss": "^66.12.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13",
    "wasm-pack": "^0.15.0",
    "cordis": "^4.0.0-rc.12"
  }
}
